{
    "out_topic": {
        "topic": "logic_in",
        "producer": {
            "bootstrap.servers": "kafka:9092",
            "message.max.bytes": 1000000000
        }
    },

    "pg_config": {
        "user": "postgres",
        "password_env": "POSTGRES_PASSWORD",
        "host": "postgres_db",
        "port": 5432,
        "database": "postgres"
    },
  "host": "0.0.0.0",
  "port": 7091,
  "max_upload_bytes": 104857600,
    "auth": {
        "enabled": true,
        "method": "basic",
        "credentials": [
            {
                "username": "admin",
        "password_env": "KAFKA_QUEUE_AUTH_PASSWORD"
            }
        ],
        "exclude_paths": [
            "/in/healthcheck"
        ]
    }
}
