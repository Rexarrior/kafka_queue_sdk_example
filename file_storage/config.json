{
    "pg_config": {
        "user": "postgres",
        "password_env": "POSTGRES_PASSWORD",
        "host": "postgres_db",
        "port": 5432,
        "database": "postgres"
    },
    "host": "0.0.0.0",
    "port": 7093,
    "storage":{
        "bucket":"files",
        "access_key_env": "SCALITY_ACCESS_KEY_ID",
        "sec_key_env": "SCALITY_SECRET_ACCESS_KEY",
        "endpoint": "http://S3-server:9000"
    },
  "storage_type": "s3",
  "max_upload_bytes": 104857600,
  "deletion_poll_interval": 1.0,
  "deletion_batch_size": 20,
  "deletion_lease_seconds": 30,
  "deletion_retry_base_seconds": 1,
  "deletion_retry_max_seconds": 60,
    "auth": {
        "enabled": true,
        "method": "basic",
        "credentials": [
            {
                "username": "admin",
        "password_env": "KAFKA_QUEUE_AUTH_PASSWORD"
            }
        ],
        "exclude_paths": [
            "/files/healthcheck"
        ]
    }
}
