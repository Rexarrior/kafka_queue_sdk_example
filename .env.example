# Infrastructure credentials for the local Docker stack.
POSTGRES_HOST=postgres_db
POSTGRES_NAME=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-me
SCALITY_ACCESS_KEY_ID=replace-me
SCALITY_SECRET_ACCESS_KEY=replace-me
SSL=false

# Required by every SDK 1.0 HTTP service and by queue-admin downstream calls.
KAFKA_QUEUE_AUTH_PASSWORD=replace-with-a-long-random-value
